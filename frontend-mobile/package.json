    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1"
