{
  "expo": {
    "name": "Kitho",
    "slug": "kitho",
    "version": "1.0.0",
    "scheme": "finanzasfamiliares",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kitho usa tu ubicación solo para sugerir la moneda local de tu familia."
        }
      ],
      "react-native-nitro-google-signin"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.finanzasfamiliares.app",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.finanzasfamiliares.app",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    }
  }
}
