{
  "expo": {
    "name": "Kitho",
    "slug": "kitho",
    "version": "1.0.0",
    "scheme": "finanzasfamiliares",
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.finanzasfamiliares.app"
    },
    "ios": {
      "bundleIdentifier": "com.finanzasfamiliares.app",
      "supportsTablet": true
    },
    "description": "Tareas y finanzas familiares con una experiencia clara y accesible."
  }
}
