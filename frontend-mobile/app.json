{
  "expo": {
    "name": "Kitho",
    "slug": "kitho",
    "version": "1.0.0",
    "scheme": "finanzasfamiliares",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "./plugins/withAndroidBuildTuning",
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kitho usa tu ubicación solo para sugerir la moneda local de tu familia."
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.633589769730-v2stl5vv1piaiaqfceg9b3gs1d6drje9"
        }
      ]
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.finanzasfamiliares.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.finanzasfamiliares.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "es",
          "en"
        ]
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e0006e60-e915-4667-bdaa-d72f735cc129"
      }
    },
    "owner": "arturomauriciodevprueba"
  }
}
