{
  "extends": ["next/core-web-vitals"],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "excludedFiles": ["components/charts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "recharts",
                "message": "Importa gráficos solo desde components/charts/ChartContainer."
              },
              {
                "name": "victory-native",
                "message": "Victory Native no se usa en web."
              },
              {
                "name": "victory",
                "message": "Victory no se usa en web."
              }
            ]
          }
        ]
      }
    }
  ]
}